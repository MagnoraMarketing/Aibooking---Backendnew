# Base URL of the main AIbooking Next.js app (Vercel) — the relay calls back
# into /api/internal/conversation-relay/turn and /end here.
AIBOOKING_APP_URL=https://your-app.vercel.app

# Must match CONVERSATION_RELAY_INTERNAL_SECRET in the Vercel app's env vars
# exactly — generate one strong random value and set it in both places.
CONVERSATION_RELAY_INTERNAL_SECRET=

# Optional — Fly.io sets this itself; only needed for local dev.
PORT=8080
