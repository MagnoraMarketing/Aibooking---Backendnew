# ---- LLM ----
ANTHROPIC_API_KEY=

# ---- TTS ----
ELEVENLABS_API_KEY=

# ---- Realtime ("Expert model" — OpenAI Realtime API over WebRTC) ----
OPENAI_API_KEY=

# ---- Vapi ("Vapi model" — Vapi Web SDK, browser-to-Vapi voice calls) ----
# Public key: safe to hand to the browser, returned as-is by
# POST /api/widget/session for provider='vapi' widgets.
VAPI_PUBLIC_KEY=
# Shared secret configured on the Vapi assistant's server URL — verified
# against the x-vapi-secret header in app/api/webhooks/vapi/route.ts.
VAPI_WEBHOOK_SECRET=
# Private/admin API key — server-only, used to create and update Vapi
# assistants via api.vapi.ai (see lib/vapi/assistants.ts). Every new agent
# created in the dashboard provisions its own assistant with this key.
VAPI_PRIVATE_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Public base URL used to build widget embed/share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used one-time by scripts/create-master-admin to bootstrap the first admin.
# Not read by the running app.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
