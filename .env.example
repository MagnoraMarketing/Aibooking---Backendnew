# ---- LLM ----
ANTHROPIC_API_KEY=

# ---- TTS ----
ELEVENLABS_API_KEY=

# ---- Realtime ("Expert model" — OpenAI Realtime API over WebRTC) ----
OPENAI_API_KEY=

# ---- Email (lib/email/*) ----
# Sends from mail@aibooking.dk via Resend's API (see lib/email/client.ts),
# and covers two kinds of mail:
#   - customer invitation emails (lib/email/invite.ts)
#   - internal notifications to mail@aibooking.dk when someone signs up or
#     pays (lib/email/internal-notifications.ts), so a new customer can be
#     rung and welcomed.
# Everything here is best-effort: without this set, signups, payments and
# onboarding all still complete — they just send no mail (logged, not thrown).
RESEND_API_KEY=

# ---- Vapi ("Vapi model" — Vapi Web SDK, browser-to-Vapi voice calls) ----
# Public key: safe to hand to the browser, returned as-is by
# POST /api/widget/session for provider='vapi' widgets.
VAPI_PUBLIC_KEY=
# Shared secret configured on the Vapi assistant's server URL — verified
# against the x-vapi-secret header in app/api/webhooks/vapi/route.ts.
VAPI_WEBHOOK_SECRET=
# Private/admin API key — server-only, used to create and update Vapi
# assistants via api.vapi.ai (see lib/vapi/assistants.ts). Every new agent
# created in the dashboard provisions its own assistant with this key.
VAPI_PRIVATE_KEY=
# Assistant id of AIbooking's own onboarding/support voice assistant (built
# and tuned directly in Vapi's own dashboard, not by this app), shown as a
# floating button on every /dashboard page — see
# components/dashboard/support-widget.tsx and
# app/api/customer/support-widget/route.ts. Left unset, the button simply
# doesn't render.
VAPI_SUPPORT_ASSISTANT_ID=

# ---- Twilio (platform master account) ----
# Used only to create a Twilio *subaccount* per customer on their first
# number search/purchase (lib/twilio/subaccounts.ts) — the actual number
# search/purchase/release then runs under that subaccount's own
# credentials, never the master account directly. Separate from the
# BYO-Twilio import flow, which takes the customer's own SID/token as
# request input instead and never touches these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Twilio Voice Relay ("Twilio Relay" Voice Widget engine, see
# 0024_twilio_conversation_relay.sql) ----
# Standard API Key (Console → Account → API keys & tokens) — used only to
# mint short-lived browser Access Tokens (lib/twilio/voice-token.ts), never
# to call the REST API directly.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App SID whose Voice Request URL is set to
# {NEXT_PUBLIC_APP_URL}/api/telephony/twilio/voice/relay-start — see
# relay-server/README.md for the full one-time Twilio Console setup.
TWILIO_TWIML_APP_SID=
# wss:// URL of the standalone relay-server/ deployment (Fly.io — see
# relay-server/README.md; this can't run on Vercel, ConversationRelay needs
# a persistent WebSocket connection for the whole call).
CONVERSATION_RELAY_WS_URL=
# Shared secret protecting app/api/internal/conversation-relay/* — must
# match relay-server's own CONVERSATION_RELAY_INTERNAL_SECRET exactly.
# Generate with: openssl rand -base64 32
CONVERSATION_RELAY_INTERNAL_SECRET=

# ---- Twilio Manual Dialer ("Dialer" tab, browser click-to-call against an
# uploaded lead list, see lib/twilio/dialer.ts) ----
# No dedicated env vars: this feature provisions its own Signing Key +
# TwiML Application directly under each customer's Twilio subaccount (see
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above), the first time that customer
# opens the dialer. Nothing to configure in the Twilio Console.

# ---- Google Calendar (OAuth) ----
# From a Google Cloud project with the Calendar API enabled. Redirect URI to
# register: {NEXT_PUBLIC_APP_URL}/api/customer/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Outlook / Microsoft 365 Calendar (OAuth) ----
# From an app registration in the Microsoft Entra admin center (Calendars.ReadWrite,
# offline_access, User.Read). Redirect URI to register:
# {NEXT_PUBLIC_APP_URL}/api/customer/calendar/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Cal.com (OAuth) ----
# From Cal.com app registration (https://cal.com/oauth). Redirect URI to register:
# {NEXT_PUBLIC_APP_URL}/api/customer/calendar/calcom/callback
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=
# Optional: Cal.com API base URL (defaults to https://api.cal.com)
# CALCOM_API_URL=https://api.cal.com

# ---- Token Encryption ----
# Encrypts OAuth tokens at rest (lib/security/crypto.ts) —
# required for all calendar OAuth integrations.
# Generate with: openssl rand -base64 32
CALENDAR_CREDENTIALS_ENCRYPTION_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Payment Link for the Voice Widget launch offer — the last step of
# the agent creation wizard (lib/billing/widget-launch.ts). Optional: leave
# it blank in production, where the built-in live link is used, and set it to
# a test-mode link while developing.
#
# Two things must be configured on the link itself in the Stripe dashboard,
# because a Payment Link takes no per-request options from us:
#   1. "Client reference ID" must be allowed (we append it to the URL) —
#      it is what tells the webhook which account the minutes belong to.
#   2. After payment -> "Redirect customers to" must be set to
#      {NEXT_PUBLIC_APP_URL}/dashboard/checkout/return?session_id={CHECKOUT_SESSION_ID}
#      so the customer lands back on their agent with the minutes already
#      credited, rather than on a Stripe receipt page.
NEXT_PUBLIC_STRIPE_WIDGET_PAYMENT_LINK=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# THE most important variable to get right in a hosted environment. It is the
# public base URL for everything this platform hands to the outside world
# (lib/app-url.ts), with no trailing slash:
#   - the embed snippet and share link a customer pastes onto their website
#   - Stripe checkout success/cancel and the widget launch return page
#   - the serverUrl a Vapi assistant posts call events back to — without a
#     reachable one there are no transcripts, no end-of-call reports and no
#     call billing
#   - Google / Outlook / Cal.com OAuth redirect_uris, which must match what
#     is registered with each provider byte-for-byte
#   - invitation email links
#   - every Twilio webhook URL (lib/telephony/urls.ts). Twilio both calls
#     these and signs its requests against them, so an unreachable or
#     mismatched value means inbound calls fail at Twilio's end. Number
#     provisioning refuses to register a webhook while this is unset or
#     points at localhost.
#
# Unset on Vercel, lib/app-url.ts falls back to VERCEL_PROJECT_PRODUCTION_URL
# (the project's stable production domain) and only then to VERCEL_URL (this
# deployment's own URL, which changes with every deploy). Both are automatic
# Vercel system variables — you do not set them — and both are a safety net,
# not a substitute: Twilio still refuses to provision, and a custom domain
# will never be used until you set this explicitly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used one-time by scripts/create-master-admin to bootstrap the first admin.
# Not read by the running app.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Cal.com webhook signing secret — set the same value on the Cal.com webhook
# and here. Verified as HMAC-SHA256 over the raw body against the
# x-cal-signature-256 header in app/api/webhooks/calcom/route.ts. Without it
# Cal.com deliveries are acknowledged but ignored, so bookings moved or
# cancelled outside the agent won't be reflected in the dashboard.
CALCOM_WEBHOOK_SECRET=

# ---- Shopify (webshop integration, see lib/shopify and
# 0035_shopify_integration.sql) ----
# The integration is API-only: nothing about the shop is crawled, indexed or
# cached. Products, descriptions, prices, variants, sizes, colours, SKUs,
# stock, collections, product URLs, delivery/returns policies, orders and
# tracking are all read from the Shopify Admin GraphQL API at the moment a
# customer asks. Without these variables the integration cannot be connected
# at all, and the agent simply has no webshop tools.
#
# Create an app in the Shopify Dev Dashboard (Partners), then:
#   1. Set its redirect URI to
#      {NEXT_PUBLIC_APP_URL}/api/customer/shopify/callback
#      — it must match byte-for-byte or Shopify rejects the install.
#   2. Request exactly the scopes in lib/shopify/oauth.ts and nothing more —
#      `read_products`, `read_orders` and `read_legal_policies`, all read-only.
#      Note: read_orders reaches the last 60 days of orders. A shop that needs
#      older ones has to be granted `read_all_orders` by Shopify — request it
#      from the app's settings if customers ask about older orders.
#   3. Copy the client ID and client secret in below.
#
# These are server-only and must never be prefixed NEXT_PUBLIC_: the secret
# both signs the OAuth callback HMAC and buys access tokens, so exposing it to
# a browser would let anyone install the app against any shop as us.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Shopify access tokens are encrypted at rest with
# CALENDAR_CREDENTIALS_ENCRYPTION_KEY (above) — the same AES-256-GCM key the
# calendar integrations use. No separate variable.

# ---- Vapi fallback voices (lib/vapi/voice-gender.ts) ----
# Only used when the admin-configured voice templates are missing. Vapi
# retires voices on its own schedule — "Lily" was rejected outright in
# production with "part of a legacy voice set that is being phased out",
# which failed the whole assistant update and stopped prompts, knowledge
# base and tools from reaching every female-voice widget. These let a stale
# voice be fixed by setting a variable instead of shipping a deploy.
# Leave blank to use the built-in defaults.
VAPI_FALLBACK_VOICE_FEMALE=
VAPI_FALLBACK_VOICE_MALE=
