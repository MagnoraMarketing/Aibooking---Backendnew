# ---- LLM ----
ANTHROPIC_API_KEY=

# ---- TTS ----
ELEVENLABS_API_KEY=

# ---- Realtime ("Expert model" — OpenAI Realtime API over WebRTC) ----
OPENAI_API_KEY=

# ---- Vapi (Voice Agent tab: Vapi-backed assistants + embeddable widget) ----
# Private — server-side only, never sent to the browser. Find it under
# Vapi Dashboard > API Keys > Private Key.
VAPI_API_KEY=
# Safe to expose to the browser (used by the embeddable widget and the
# in-dashboard Test Agent). Vapi Dashboard > API Keys > Public Key.
VAPI_PUBLIC_KEY=
# Optional shared secret for POST /api/webhooks/vapi. When set, this app
# automatically embeds it as a query param on the webhook URL it registers
# with each Vapi assistant (Vapi's assistant config has no signature/secret
# field, so this is the verification mechanism — see lib/vapi/webhook.ts).
# Leave blank to accept webhook deliveries unverified (fine for local dev).
VAPI_WEBHOOK_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Public base URL used to build widget embed/share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used one-time by scripts/create-master-admin to bootstrap the first admin.
# Not read by the running app.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
